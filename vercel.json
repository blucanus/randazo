{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/register",
      "destination": "https://eventos.hands.com.ar/api/register"
    },
    {
      "source": "/api/events",
      "destination": "https://eventos.hands.com.ar/api/events"
    },
    {
      "source": "/api/invitaciones",
      "destination": "https://eventos.hands.com.ar/api/invitaciones"
    },
    {
      "source": "/e/randazzo",
      "destination": "/"
    },
    {
      "source": "/e/randazzo/gracias",
      "destination": "/gracias"
    },
    {
      "source": "/e/randazzo/assets/:path*",
      "destination": "/assets/:path*"
    }
  ],
  "headers": [
    {
      "source": "/assets/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
